{
  "manifest_version": 3,
  "name": "Estúdio · Captura de elemento",
  "short_name": "Captura",
  "version": "1.2.0",
  "description": "Passe o mouse para destacar um elemento da página (como o Inspecionar do DevTools) e clique para tirar um print só dele.",
  "action": { "default_title": "Capturar um elemento (Alt+Shift+S)", "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" } },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "debugger"],
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Capturar um elemento" } },
  "homepage_url": "https://cw-rodrigo.github.io/#/ferramentas/captura"
}
